msgstr "Ішкі файл қарап шығу терезесінің биіктігі."

#: data/org.gnome.gnome-commander.gschema.xml:1023
msgid "Window state"
msgstr "Терезе қалып-күйі"

#: data/org.gnome.gnome-commander.gschema.xml:1024
