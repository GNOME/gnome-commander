msgstr "Ішкі файл қарап шығу терезесінің ені."

#: data/org.gnome.gnome-commander.gschema.xml:1016
msgid "Window height"
msgstr "Терезенің биіктігі"

#: data/org.gnome.gnome-commander.gschema.xml:1017
