#: data/org.gnome.gnome-commander.desktop.in:2
#: data/org.gnome.gnome-commander.metainfo.xml.in:16
#: gnome-commander/src/main_win.rs:232
msgid "Gnome Commander"
msgstr "Gnome Commander"

#: data/org.gnome.gnome-commander.desktop.in:3
msgid "A file manager using dual-panel layout"
msgstr "Správce souborů využívající dvoupanelové rozložení"

#. TRANSLATORS: Search terms to find this application. Do NOT translate or localize the semicolons! The list MUST also end with a semicolon!
#: data/org.gnome.gnome-commander.desktop.in:5
msgid "file;manager;folder;explore;disk;filesystem;"
msgstr ""
"soubor;správce;správa;složka;procházet;průzkumník;disk;souborový "
"systém;systém souborů;"

#: data/org.gnome.gnome-commander.gschema.xml:45
msgid "List of advanced rename tool profiles"
msgstr "Seznam profilů pokročilého nástroje přejmenování"

#: data/org.gnome.gnome-commander.gschema.xml:46
msgid ""
"The entries in this array represent the profiles in the advanced rename tool "
"with specific settings for each profile."
msgstr ""
"Položky v tomto poli představují profily v pokročilém nástroji přejmenování "
"s konkrétními nastaveními jednotlivých profilů."

#: data/org.gnome.gnome-commander.gschema.xml:52
msgid "Advanced rename tool window width"
msgstr "Šířka okna Pokročilý nástroj přejmenování"

#: data/org.gnome.gnome-commander.gschema.xml:53
msgid "This option defines the width of the advanced rename tool window."
msgstr "Volba určující šířku okna pokročilého nástroje přejmenování."

#: data/org.gnome.gnome-commander.gschema.xml:59
msgid "Advanced rename tool window height"
msgstr "Výška okna Pokročilý nástroj přejmenování"

#: data/org.gnome.gnome-commander.gschema.xml:60
msgid "This option defines the height of the advanced rename tool window."
msgstr "Volba určující výšku okna pokročilého nástroje přejmenování."

#: data/org.gnome.gnome-commander.gschema.xml:66
msgid "Advanced rename tool template history"
msgstr "Historie šablon Pokročilý nástroj přejmenování"

#: data/org.gnome.gnome-commander.gschema.xml:67
msgid ""
"This string array represents the history of templates in the advanced rename "
"tool."
msgstr ""
"Pole řetězců představujících historii šablon v pokročilém nástroji "
"přejmenování."

#: data/org.gnome.gnome-commander.gschema.xml:73
msgid "History of visited directories"
msgstr "Historie navštívených složek"

#: data/org.gnome.gnome-commander.gschema.xml:74
msgid "This string array represents the history of visited directories."
msgstr "Pole řetězců představujících historii navštívených složek."

#: data/org.gnome.gnome-commander.gschema.xml:80
msgid "Filesize display mode"
msgstr "Režim zobrazení velikosti souboru"

#: data/org.gnome.gnome-commander.gschema.xml:81
msgid ""
"Defines how the filesize will be displayed in the associated panel column."
msgstr ""
"Určuje, jak se má zobrazovat velikost souborů v příslušném sloupci v panelu."

#: data/org.gnome.gnome-commander.gschema.xml:87
#: gnome-commander/src/dialogs/options/format_tab.rs:86
msgid "Permission display mode"
msgstr "Režim zobrazení přístupových práv"

#: data/org.gnome.gnome-commander.gschema.xml:88
msgid ""
"Defines how the file permission will be displayed in the associated panel "
"column."
msgstr ""
"Určuje, jak se mají zobrazovat oprávnění souboru v příslušném sloupci v "
"panelu."

#: data/org.gnome.gnome-commander.gschema.xml:94
msgid "Graphical layout mode"
msgstr "Režim grafických prvků"

#: data/org.gnome.gnome-commander.gschema.xml:95
msgid "Defines the icon style of files and folders in the file panels."
msgstr "Určuje styl ikon pro soubory a složky v panelech se soubory."

#. Translators: Feel free to replace the default date format to a common value
#. used in your country. See https://docs.gtk.org/glib/method.DateTime.format.html for details.
#. Attention: Do not change the single quotes which sourround the string.
#. If nothing is set, the application uses the hard-coded value '%c', which is
#. "the preferred date and time representation for the current locale".
#: data/org.gnome.gnome-commander.gschema.xml:105
msgid "'%F %R'"
msgstr "'%-d.%-m.%Y %k∶%M'"

#: data/org.gnome.gnome-commander.gschema.xml:106
#: gnome-commander/src/dialogs/options/format_tab.rs:94
msgid "Date format"
msgstr "Formát data"

#: data/org.gnome.gnome-commander.gschema.xml:107
msgid "Format of the date in the file panel."
msgstr "Formát data v panelech se soubory."

#: data/org.gnome.gnome-commander.gschema.xml:113
msgid "List font"
msgstr "Font výpisu"

#: data/org.gnome.gnome-commander.gschema.xml:114
msgid "The font in the file panels."
msgstr "Font v panelech se soubory."

#: data/org.gnome.gnome-commander.gschema.xml:118
msgid "Extension display mode"
msgstr "Režim zobrazení přípon"

#: data/org.gnome.gnome-commander.gschema.xml:119
msgid "Defines where the file name extension is displayed."
msgstr "Určuje, kde se má zobrazovat přípona názvu souboru."

#: data/org.gnome.gnome-commander.gschema.xml:125
msgid "Left mouse button mode"
msgstr "Režim levého tlačítka myši"

#: data/org.gnome.gnome-commander.gschema.xml:126
msgid "Number of left mouse button clicks for opening a file or folder."
msgstr ""
"Počet kliknutí levým tlačítkem myši, kterými se otevře soubor nebo složka."

#: data/org.gnome.gnome-commander.gschema.xml:132
msgid "Left mouse button unselects"
msgstr "Levé tlačítko myši ruší výběr"

#: data/org.gnome.gnome-commander.gschema.xml:133
msgid ""
"Defines if a click on an unselected item unselects already selected items."
msgstr "Určuje, jestli kliknutí na vybrané položky jejich výběr ruší."

#: data/org.gnome.gnome-commander.gschema.xml:139
msgid "Right mouse button mode"
msgstr "Režim pravého tlačítka myši"

#: data/org.gnome.gnome-commander.gschema.xml:140
msgid "Defines what happens when the right mouse button is clicked on an item."
msgstr ""
"Určuje, co se má stát, když se klikne pravým tlačítkem myši na položku."

#: data/org.gnome.gnome-commander.gschema.xml:146
msgid "Use trash"
msgstr "Používat koš"

#: data/org.gnome.gnome-commander.gschema.xml:147
msgid ""
"Defines if items should be moved to trash by default instead of really "
"deleting them."
msgstr ""
"Definuje, jestli se položky mají standardně místo skutečného odstranění "
"pouze přesunout do koše."

#: data/org.gnome.gnome-commander.gschema.xml:153
msgid "Command line history"
msgstr "Historie příkazového řádku"

#: data/org.gnome.gnome-commander.gschema.xml:154
msgid ""
"This string array represents the history of commands executed in the command "
"line."
msgstr ""
"Pole řetězců představujících historii příkazů spuštěných v příkazovém řádku."

#: data/org.gnome.gnome-commander.gschema.xml:161
msgid "Command line history length"
msgstr "Délka historie příkazového řádku"

#: data/org.gnome.gnome-commander.gschema.xml:165
msgid "Split between panels and command line"
msgstr "Rozdělit mezi panely a příkazový řádek"

#: data/org.gnome.gnome-commander.gschema.xml:166
msgid ""
"Determines the height of file panels in pixels. Remaining vertical space is "
"allocated for the command line."
msgstr ""
"Určuje výšku panelů souborů v pixelech. Zbývající vertikální místo je "
"přiděleno pro příkazový řádek."

#: data/org.gnome.gnome-commander.gschema.xml:172
msgid "Automatically hide command line output"
msgstr "Automaticky skrýt výstup příkazového řádku"

#: data/org.gnome.gnome-commander.gschema.xml:173
msgid ""
"If enabled, command line output is hidden automatically when the command "
"line is inactive."
msgstr ""
"Pokud je povoleno, výstup příkazového řádku se automaticky skryje, když je "
"příkazový řádek neaktivní."

#: data/org.gnome.gnome-commander.gschema.xml:179
msgid "Horizontal orientation"
msgstr "Vodorovná orientace"

#: data/org.gnome.gnome-commander.gschema.xml:180
msgid ""
"Defines if the orientation of the file panels should be horizontal or not."
msgstr "Určuje, jestli mají být panely se soubory otočené vodorovně nebo ne."

#: data/org.gnome.gnome-commander.gschema.xml:187
msgid "GUI update rate"
msgstr "Četnost aktualizace GUI"

#: data/org.gnome.gnome-commander.gschema.xml:188
msgid "Update rate of the graphical user interface in 1/1000ths of a second."
msgstr ""
"Rychlost aktualizace grafického uživatelského rozhraní za 1/1000 sekundy."

#: data/org.gnome.gnome-commander.gschema.xml:192
msgid "Show device buttons"
msgstr "Zobrazovat tlačítka zařízení"

#: data/org.gnome.gnome-commander.gschema.xml:193
msgid "Defines if device buttons are shown."
msgstr "Určuje, jestli mají být zobrazena tlačítka pro jednotlivá zařízení."

#: data/org.gnome.gnome-commander.gschema.xml:197
msgid "Show device list"
msgstr "Zobrazovat seznam zařízení"

#: data/org.gnome.gnome-commander.gschema.xml:198
msgid "Defines if the list of devices is shown."
msgstr "Určuje, jestli má být zobrazen seznam zařízení."

#: data/org.gnome.gnome-commander.gschema.xml:202
msgid "Show command line"
msgstr "Zobrazovat příkazový řádek"

#: data/org.gnome.gnome-commander.gschema.xml:203
msgid "Defines if command line is shown."
msgstr "Určuje, jestli má být zobrazen příkazový řádek."

#: data/org.gnome.gnome-commander.gschema.xml:207
msgid "Show toolbar"
msgstr "Zobrazovat nástrojovou lištu"

#: data/org.gnome.gnome-commander.gschema.xml:208
msgid "Defines if the toolbar is shown."
msgstr "Určuje, jestli má být zobrazena nástrojová lišta."

#: data/org.gnome.gnome-commander.gschema.xml:212
msgid "Show buttonbar"
msgstr "Zobrazovat tlačítkovou lištu"

#: data/org.gnome.gnome-commander.gschema.xml:213
msgid "Defines if the buttonbar is shown."
msgstr "Určuje, jestli má být zobrazena tlačítková lišta."

#: data/org.gnome.gnome-commander.gschema.xml:217
msgid "Symlink string"
msgstr "Řetězec symbolického odkazu"

#: data/org.gnome.gnome-commander.gschema.xml:218
msgid ""
"This string defines the default name of a newly created symlink. Leave the "
"string empty to use the default value which is hard coded into the program "
"code. A “%s” will be expanded to the item name for which a link should be "
"created."
msgstr ""
"Tento řetězec určuje výchozí název nově vytvořeného symbolického odkazu. "
"Když chcete používat výchozí hodnotu napevno zabudovanou v programu, "
"ponechte řetězec prázdný. Zástupce „%s“ bude nahrazen názvem souboru, pro "
"který se symbolický odkaz vytváří."

#: data/org.gnome.gnome-commander.gschema.xml:226
msgid "Main window width"
msgstr "Šířka hlavního okna"

#: data/org.gnome.gnome-commander.gschema.xml:227
msgid "This option defines the width of the main window."
msgstr "Volba určující šířku hlavního okna."

#: data/org.gnome.gnome-commander.gschema.xml:233
msgid "List of bookmarks"
msgstr "Seznam záložek"

#: data/org.gnome.gnome-commander.gschema.xml:234
msgid "Each entry in this list represents a bookmark."
msgstr "Jednotlivé položky seznamu představují záložky."

#: data/org.gnome.gnome-commander.gschema.xml:240
msgid "Bookmarks window width"
msgstr "Šířka okna Záložky"

#: data/org.gnome.gnome-commander.gschema.xml:241
msgid "This option defines the width of the bookmarks window."
msgstr "Volba určující šířku okna záložek."

#: data/org.gnome.gnome-commander.gschema.xml:247
msgid "Bookmarks window height"
msgstr "Výška okna Záložky"

#: data/org.gnome.gnome-commander.gschema.xml:248
msgid "This option defines the height of the bookmarks window."
msgstr "Volba určující výšku okna záložek."

#: data/org.gnome.gnome-commander.gschema.xml:254
msgid "List of connections"
msgstr "Seznam připojení"

#: data/org.gnome.gnome-commander.gschema.xml:255
msgid "Each entry in this list represents a connection."
msgstr "Jednotlivé položky seznamu představujní připojení."

#: data/org.gnome.gnome-commander.gschema.xml:261
msgid "Main window height"
msgstr "Výška hlavního okna"

#: data/org.gnome.gnome-commander.gschema.xml:262
msgid "This option defines the height of the main window."
msgstr "Volba určující výšku hlavního okna."

#: data/org.gnome.gnome-commander.gschema.xml:268
msgid "Options dialog width"
msgstr "Šířka dialogového okna s volbami"

#: data/org.gnome.gnome-commander.gschema.xml:269
msgid "This setting defines the width of the options dialog window."
msgstr "Nastavení určující šířku dialogového okna s volbami."

#: data/org.gnome.gnome-commander.gschema.xml:275
msgid "Options dialog height"
msgstr "Výška dialogového okna s volbami"

#: data/org.gnome.gnome-commander.gschema.xml:276
msgid "This setting defines the height of the options dialog window."
msgstr "Nastavení určující výšku dialogového okna s volbami."

#: data/org.gnome.gnome-commander.gschema.xml:282
msgid "Width of icon column"
msgstr "Šířka sloupce s ikonami"

#: data/org.gnome.gnome-commander.gschema.xml:283
#: data/org.gnome.gnome-commander.gschema.xml:290
#: data/org.gnome.gnome-commander.gschema.xml:297
#: data/org.gnome.gnome-commander.gschema.xml:304
#: data/org.gnome.gnome-commander.gschema.xml:311
#: data/org.gnome.gnome-commander.gschema.xml:318
#: data/org.gnome.gnome-commander.gschema.xml:325
#: data/org.gnome.gnome-commander.gschema.xml:332
#: data/org.gnome.gnome-commander.gschema.xml:339
#: data/org.gnome.gnome-commander.gschema.xml:346
#: data/org.gnome.gnome-commander.gschema.xml:480
#: data/org.gnome.gnome-commander.gschema.xml:551
msgid ""
"This setting is only present for backwards compatibility and will be removed "
"in future."
msgstr ""
"Toto nastavení je k dispozici pouze z důvodu zpětné kompatibility a v "
"budoucnu bude odstraněno."

#: data/org.gnome.gnome-commander.gschema.xml:289
msgid "Width of name column"
msgstr "Šířka sloupce s názvy"

#: data/org.gnome.gnome-commander.gschema.xml:296
msgid "Width of extension column"
msgstr "Šířka sloupce s příponami"

#: data/org.gnome.gnome-commander.gschema.xml:303
msgid "Width of directory column"
msgstr "Šířka sloupce se složkami"

#: data/org.gnome.gnome-commander.gschema.xml:310
msgid "Width of size column"
msgstr "Šířka sloupce s velikostmi"

#: data/org.gnome.gnome-commander.gschema.xml:317
msgid "Width of date column"
msgstr "Šířka sloupce s daty"

#: data/org.gnome.gnome-commander.gschema.xml:324
msgid "Width of permissions column"
msgstr "Šířka sloupce s oprávněními"

#: data/org.gnome.gnome-commander.gschema.xml:331
msgid "Width of owner column"
msgstr "Šířka sloupce s vlastníky"

#: data/org.gnome.gnome-commander.gschema.xml:338
msgid "Width of group column"
msgstr "Šířka sloupce se skupinami"

#: data/org.gnome.gnome-commander.gschema.xml:345
msgid "Legacy list of keybindings"
msgstr "Zastaralý seznam klávesových zkratek"

#: data/org.gnome.gnome-commander.gschema.xml:352
msgid "List of keybindings"
msgstr "Seznam klávesových zkratek"

#: data/org.gnome.gnome-commander.gschema.xml:353
msgid "Each entry in this list represents a keybinding."
msgstr "Jednotlivé položky seznamu představují klávesové zkratky."

#: data/org.gnome.gnome-commander.gschema.xml:360
msgid "Main window state"
msgstr "Stav hlavního okna"

#: data/org.gnome.gnome-commander.gschema.xml:361
msgid ""
"The number represents the main window state, e.g. “maximized”, “fullscreen”, "
"etc. and is calculated internally."
msgstr ""
"Číslo představující stav hlavního okna, např. „maximized“, „fullscreen“ atd. "
"Je vypočítána interně."

#: data/org.gnome.gnome-commander.gschema.xml:367
msgid "Middle mouse button mode"
msgstr "Režim prostředního tlačítka myši"

#: data/org.gnome.gnome-commander.gschema.xml:368
msgid "Defines what happens when the middle mouse button is clicked."
msgstr "Určuje, co se má stát, když se klikne prostředním tlačítkem myši."

#: data/org.gnome.gnome-commander.gschema.xml:374
msgid "Save directories on exit"
msgstr "Při ukončení uložit složky"

#: data/org.gnome.gnome-commander.gschema.xml:375
msgid ""
"Defines if the current directories are opened again when Gnome Commander is "
"restarted."
msgstr ""
"Určuje, zda se aktuální adresáře znovu otevřou po opětovném spuštění Gnome "
"Commander."

#: data/org.gnome.gnome-commander.gschema.xml:381
msgid "Save tabs on exit"
msgstr "Při ukončení uložit karty"

#: data/org.gnome.gnome-commander.gschema.xml:382
msgid ""
"Defines if the current open tabs are opened again when Gnome Commander is "
"restarted."
msgstr ""
"Určuje, zda se po opětovném spuštění Gnome Commanderu znovu otevřou aktuální "
"otevřené karty."

#: data/org.gnome.gnome-commander.gschema.xml:388
msgid "Save directory history on exit"
msgstr "Při ukončení uložit historii složky"

#: data/org.gnome.gnome-commander.gschema.xml:389
msgid "Defines if the history of visited directories is saved on exit."
msgstr "Určuje, jestli se má při ukončení uložit historie navštívených složek."

#: data/org.gnome.gnome-commander.gschema.xml:395
msgid "Save commandline history on exit"
msgstr "Při ukončení uložit historii příkazové řádky"

#: data/org.gnome.gnome-commander.gschema.xml:396
msgid "Defines if the history of commands in the commandline is saved on exit."
msgstr ""
"Určuje, jestli se má při ukončení uložit historie příkazů v příkazové řádce."

#: data/org.gnome.gnome-commander.gschema.xml:402
msgid "Save search history on exit"
msgstr "Při ukončení uložit historii hledání"

#: data/org.gnome.gnome-commander.gschema.xml:403
msgid "Defines if the history of search patterns is saved on exit."
msgstr "Určuje, jestli se má při ukončení uložit historie vzorů vyhledávání."

#: data/org.gnome.gnome-commander.gschema.xml:409
msgid "Always show tab bar"
msgstr "Vždy zobrazovat lištu karet"

#: data/org.gnome.gnome-commander.gschema.xml:410
msgid "Defines if the tab bar is always shown."
msgstr "Určuje, jestli se má vždy zobrazovat lišta s oušky karet."

#: data/org.gnome.gnome-commander.gschema.xml:416
#: gnome-commander/src/dialogs/options/tabs_tab.rs:62
msgid "Tab lock indicator"
msgstr "Indikátor zamknuté karty"

#: data/org.gnome.gnome-commander.gschema.xml:417
msgid "Defines the style of the tab lock indicator."
msgstr "Určuje styl signalizace zamčení karty."

#: data/org.gnome.gnome-commander.gschema.xml:423
msgid "Select directories when all is marked"
msgstr "Při označení všeho vybrat složky"

#: data/org.gnome.gnome-commander.gschema.xml:424
msgid ""
"This option defines if directories will be marked when all items in a file "
"panel should be marked."
msgstr ""
"Tato volba určuje, jestli se označí i složky, když se mají v panelu se "
"soubory označit všechny položky."

#: data/org.gnome.gnome-commander.gschema.xml:430
msgid "Allow multiple instances"
msgstr "Povolit vícenásobné spuštění"

#: data/org.gnome.gnome-commander.gschema.xml:431
msgid "This option defines if multiple instances are allowed."
msgstr "Volba určující, jestli je povoleno spuštění více instancí."

#: data/org.gnome.gnome-commander.gschema.xml:437
msgid "Only device icons"
msgstr "Jen ikony zařízení"

#: data/org.gnome.gnome-commander.gschema.xml:438
msgid ""
"This option defines if only device icons should be shown instead of icons "
"and text label."
msgstr ""
"Tato volba určuje jestli se má u zařízení místo ikony a textu zobrazovat jen "
"ikona."

#: data/org.gnome.gnome-commander.gschema.xml:444
msgid "Show the samba workgroups icon"
msgstr "Zobrazovat ikonu pracovních skupin Samby"

#: data/org.gnome.gnome-commander.gschema.xml:445
msgid ""
"This option defines if the Samba workgroups icon should be shown in the "
"devices list."
msgstr ""
"Tato volba určuje, jestli se má v seznamu zařízení zobrazovat ikona "
"pracovních skupin Samby."

#: data/org.gnome.gnome-commander.gschema.xml:451
msgid "Main menu visibility"
msgstr "Viditelnost hlavní nabídky"

#: data/org.gnome.gnome-commander.gschema.xml:452
msgid "This option defines if the main menu is visible or not."
msgstr "Volba určující, jestli je hlavní nabídka viditelná či nikoliv."

#: data/org.gnome.gnome-commander.gschema.xml:458
msgid "Quick search shortcut"
msgstr "Klávesová zkratka rychlého hledání"

#: data/org.gnome.gnome-commander.gschema.xml:459
msgid "This option defines the shortcut for quick search."
msgstr "Volba určující klávesovou zkratku pro rychlé hledání."

#: data/org.gnome.gnome-commander.gschema.xml:465
msgid "Default Quick Search mode"
msgstr "Výchozí režim rychlého vyhledávání"

#: data/org.gnome.gnome-commander.gschema.xml:466
msgid "This option defines which mode Quick Search opens with."
msgstr "Tato možnost určuje, v jakém režimu se otevře rychlé hledání."

#: data/org.gnome.gnome-commander.gschema.xml:472
msgid "Case sensitive Quick Search"
msgstr "Rychlé vyhledávání rozlišují velká a malá písmena"

#: data/org.gnome.gnome-commander.gschema.xml:473
msgid ""
"This option is used to remember the state of the \"Case Sensitive\" toggle "
"in Quick Search."
msgstr ""
"Tato možnost se používá k zapamatování stavu přepínače \"Rozlišovat malá a "
"velká písmena\" v Rychlém vyhledávání."

#: data/org.gnome.gnome-commander.gschema.xml:479
msgid "Legacy list of file tabs"
msgstr "Zastaralý seznam karet"

#: data/org.gnome.gnome-commander.gschema.xml:486
msgid "List of file tabs"
msgstr "Seznam karet"

#: data/org.gnome.gnome-commander.gschema.xml:487
msgid ""
"The entries in this list are used for restoring the tabs and their history "
"from the last session."
msgstr ""
"Položky v tomto seznamu slouží k obnovení karet a jejich historie z poslední "
"relace."

#: data/org.gnome.gnome-commander.gschema.xml:494
msgid "List of devices - deprecated"
msgstr "Seznam zařízení – zastaralé"

#: data/org.gnome.gnome-commander.gschema.xml:495
#: data/org.gnome.gnome-commander.gschema.xml:502
msgid "The entries in this list represent the devices configured by the user."
msgstr "Jednotlivé položky seznamu představují zařízení nastavená uživatelem."

#: data/org.gnome.gnome-commander.gschema.xml:501
msgid "List of devices"
msgstr "Seznam zařízení"

#: data/org.gnome.gnome-commander.gschema.xml:508
msgid "List of favorite apps"
msgstr "Seznam oblíbených aplikací"

#: data/org.gnome.gnome-commander.gschema.xml:509
msgid ""
"The entries in this list represent the favorite apps configured by the user."
msgstr ""
"Jednotlivé položky seznamu představují oblíbené aplikace nastavené "
"uživatelem."

#: data/org.gnome.gnome-commander.gschema.xml:515
msgid "Search window width"
msgstr "Šířka okna vyhledávání"

#: data/org.gnome.gnome-commander.gschema.xml:516
msgid "This option defines the width of the search window."
msgstr "Volba určující šířku okna vyhledávání."

#: data/org.gnome.gnome-commander.gschema.xml:522
msgid "Search window height"
msgstr "Výška okna vyhledávání"

#: data/org.gnome.gnome-commander.gschema.xml:523
msgid "This option defines the height of the search window."
msgstr "Volba určující výšku okna vyhledávání."

#: data/org.gnome.gnome-commander.gschema.xml:529
msgid "Search window is transient"
msgstr "Vyhledávací okno je přechodné"

#: data/org.gnome.gnome-commander.gschema.xml:530
msgid ""
"Defines if the search window is transient or if it can be minimized and "
"moved behind the main window."
msgstr ""
"Určuje, zda je vyhledávací okno přechodné nebo zda jej lze minimalizovat a "
"přesunout za hlavní okno."

#: data/org.gnome.gnome-commander.gschema.xml:536
msgid "Search text history"
msgstr "Historie hledaných textů"

#: data/org.gnome.gnome-commander.gschema.xml:537
msgid ""
"This string array represents the history of text searches in the search tool."
msgstr ""
"Pole řetězců představujících historii hledaných textů ve vyhledávacím "
"nástroji."

#: data/org.gnome.gnome-commander.gschema.xml:543
msgid "Search pattern history"
msgstr "Historie hledaných vzorů"

#: data/org.gnome.gnome-commander.gschema.xml:544
msgid ""
"This string array represents the history of regular expression searches in "
"the search tool."
msgstr ""
"Pole řetězců představujících historii hledaných regulárních výrazů ve "
"vyhledávacím nástroji."

#: data/org.gnome.gnome-commander.gschema.xml:550
msgid "Legacy search tool profiles"
msgstr "Zastaralé profily vyhledávacích nástrojů"

#: data/org.gnome.gnome-commander.gschema.xml:557
msgid "List of search tool profiles"
msgstr "Seznam profilů vyhledávacího nástroje"

#: data/org.gnome.gnome-commander.gschema.xml:558
msgid ""
"The entries in this array represent the profiles in the search tool with "
"specific settings for each profile."
msgstr ""
"Položky v tomto poli představují profily ve vyhledávacím nástroji s "
"konkrétními nastaveními pro jednotlivé profily."

#: data/org.gnome.gnome-commander.gschema.xml:566
msgid "Quick connect URI"
msgstr "URI pro rychlé připojení"

#: data/org.gnome.gnome-commander.gschema.xml:567
msgid "Unified resource identifier for quick connections."
msgstr "Adresa URI sloužící pro rychlé připojení."

#: data/org.gnome.gnome-commander.gschema.xml:578
msgid "Password for anonymous FTP connections"
msgstr "Heslo pro anonymní připojení k FTP"

#: data/org.gnome.gnome-commander.gschema.xml:579
msgid "This string defines the password for anonymous FTP connections."
msgstr "Řetěze určující heslo pro anonymní připojení k FTP."

#: data/org.gnome.gnome-commander.gschema.xml:587
msgid "Confirm delete"
msgstr "Potvrzovat odstranění"

#: data/org.gnome.gnome-commander.gschema.xml:588
msgid "Defines if deletion of an item should be confirmed."
msgstr "Určuje, jestli se má při mazání požadovat potvrzení."

#: data/org.gnome.gnome-commander.gschema.xml:594
msgid "Delete default"
msgstr "Výchozí akce při odstraňování"

#: data/org.gnome.gnome-commander.gschema.xml:595
msgid ""
"This setting defines the default active option in the delete confirmation "
"dialog."
msgstr ""
"Toto nastavení určuje výchozí aktivní volbu v dialogovém okně pro potvrzení "
"odstranění."

#: data/org.gnome.gnome-commander.gschema.xml:601
msgid "Confirm copy overwrite"
msgstr "Potvrzovat přepis při kopírování"

#: data/org.gnome.gnome-commander.gschema.xml:602
msgid ""
"This option defines the default behavior when items will be overwritten by a "
"copy command."
msgstr ""
"Tato volba určuje výchozí chování, když mají být přepsány položky příkazem "
"pro kopírování."

#: data/org.gnome.gnome-commander.gschema.xml:608
msgid "Confirm move overwrite"
msgstr "Potvrzovat přepis při přesunu"

#: data/org.gnome.gnome-commander.gschema.xml:609
msgid ""
"This option defines the default behavior when items will be overwritten by a "
"move command."
msgstr ""
"Tato volba určuje výchozí chování, když mají být přepsány položky příkazem "
"pro přesun."

#: data/org.gnome.gnome-commander.gschema.xml:615
msgid "Confirm mouse drag and drop"
msgstr "Potvrzovat operace táhni a upusť"

#: data/org.gnome.gnome-commander.gschema.xml:616
msgid "This option defines the behavior of mouse drag and drop operations."
msgstr "Tato volba určuje výchozí chování pro operace „táhni a upusť“."

#: data/org.gnome.gnome-commander.gschema.xml:624
msgid "Hide unknown filetypes"
msgstr "Skrývat neznámé typy souborů"

#: data/org.gnome.gnome-commander.gschema.xml:625
msgid "Hide files which type does not match to one of the other types."
msgstr "Skrýt soubory, jejichž typ neodpovídá žádnému z ostatních typů."

#: data/org.gnome.gnome-commander.gschema.xml:629
msgid "Hide regular files"
msgstr "Skrývat běžné soubory"

#: data/org.gnome.gnome-commander.gschema.xml:633
msgid "Hide directories"
msgstr "Skrývat složky"

#: data/org.gnome.gnome-commander.gschema.xml:637
msgid "Hide symbolic links"
msgstr "Skrývat symbolické odkazy"

#: data/org.gnome.gnome-commander.gschema.xml:641
msgid ""
"Hide special files, such as a socket, fifo, block devices, or character "
"devices."
msgstr ""
"Skrývat speciální soubory, jako jsou sokety, pojmenované roury, bloková "
"zařízení nebo znaková zařízení."

#: data/org.gnome.gnome-commander.gschema.xml:645
msgid "Hide files and folders starting with a dot"
msgstr "Skrývat soubory a složky začínající tečkou"

#: data/org.gnome.gnome-commander.gschema.xml:649
msgid "Hide backup files"
msgstr "Skrývat záložní soubory"

#: data/org.gnome.gnome-commander.gschema.xml:650
msgid "Hide all files with a suffix defined as the backup pattern."
msgstr ""
"Skrývat všechny soubory, jejich přípona je odpovídá vzoru záložních souborů."

#: data/org.gnome.gnome-commander.gschema.xml:654
msgid "Backup file pattern"
msgstr "Vzor záložních souborů"

#: data/org.gnome.gnome-commander.gschema.xml:655
msgid ""
"The given string defines suffixes (separated by semicolon) for files which "
"should be filtered out if backup files should be hidden."
msgstr ""
"Zadaný řetězec určuje přípony (oddělené středníky) pro soubory, které mají "
"být odfiltrovány, když je požadováno skrytí záložních souborů."

#: data/org.gnome.gnome-commander.gschema.xml:664
msgid "Do not download files"
msgstr "Nestahovat soubory"

#: data/org.gnome.gnome-commander.gschema.xml:665
msgid ""
"This option defines if remote files should be downloaded before opened by "
"external programs."
msgstr ""
"Tato volba určuje, jestli se mají stahovat vzdálené soubory před jejich "
"otevřením v externím programu."

#: data/org.gnome.gnome-commander.gschema.xml:671
msgid "Use internal viewer"
msgstr "Používat interní prohlížeč"

#: data/org.gnome.gnome-commander.gschema.xml:672
msgid "This option defines if the internal viewer should be used by default."
msgstr ""
"Tato volba určuje, jestli se má jako výchozí používat interní prohlížeč."

#: data/org.gnome.gnome-commander.gschema.xml:678
msgid "Viewer command"
msgstr "Příkaz pro prohlížeč"

#: data/org.gnome.gnome-commander.gschema.xml:679
msgid "This string defines the command for starting the (external) viewer."
msgstr "Řetězec určující příkaz, který spustí (externí) prohlížeč."

#: data/org.gnome.gnome-commander.gschema.xml:685
msgid "Editor command"
msgstr "Příkaz pro editor"

#: data/org.gnome.gnome-commander.gschema.xml:686
msgid "This string defines the command for starting the editor."
msgstr "Řetězec určující příkaz, který spustí editor."

#: data/org.gnome.gnome-commander.gschema.xml:692
msgid "Differ command"
msgstr "Příkaz pro rozdíly"

#: data/org.gnome.gnome-commander.gschema.xml:693
msgid "This string defines the command for starting the diff tool."
msgstr ""
"Tento řetězec určuje příkaz pro spuštění nástroje, který zobrazí rozdíly "
"mezi soubory."

#: data/org.gnome.gnome-commander.gschema.xml:699
msgid "Use internal search"
msgstr "Používat interní vyhledávání"

#: data/org.gnome.gnome-commander.gschema.xml:700
msgid "This option defines if the internal search should be used by default."
msgstr ""
"Tato možnost určuje, zda se má standardně používat interní vyhledávání."

#: data/org.gnome.gnome-commander.gschema.xml:706
msgid "Search command"
msgstr "Vyhledávací příkaz"

#: data/org.gnome.gnome-commander.gschema.xml:707
msgid ""
"This string defines the command for starting an external file search tool."
msgstr ""
"Řetězec určující příkaz, který spustí externí nástroj pro vyhledávání "
"souborů."

#: data/org.gnome.gnome-commander.gschema.xml:713
msgid "Command for opening a terminal"
msgstr "Příkaz pro otevření terminálu"

#: data/org.gnome.gnome-commander.gschema.xml:714
msgid "This string defines the command for opening a terminal."
msgstr "Tento řetězec určuje příkaz pro otevření v terminálu."

#: data/org.gnome.gnome-commander.gschema.xml:720
msgid "Command for execution in terminal"
msgstr "Příkaz pro spuštění v terminálu"

#: data/org.gnome.gnome-commander.gschema.xml:721
msgid ""
"This string defines the command for executing another command in a terminal."
msgstr "Tento řetězec určuje příkaz pro spuštění jiného příkazu v terminálu."

#: data/org.gnome.gnome-commander.gschema.xml:727
msgid "Send to command"
msgstr "Příkaz pro odeslání souborů"

#: data/org.gnome.gnome-commander.gschema.xml:728
msgid "This string defines the command for sending files to a receiver."
msgstr "Tento řetězec určuje příkaz pro odesílání souborů příjemci."

#: data/org.gnome.gnome-commander.gschema.xml:736
msgid "Color theme"
msgstr "Motiv barev"

#: data/org.gnome.gnome-commander.gschema.xml:737
msgid "This option defines the current color theme."
msgstr "Tato volba určuje aktuální motiv barev."

#: data/org.gnome.gnome-commander.gschema.xml:743
msgid "Normal foreground color"
msgstr "Barva normálního popředí"

#: data/org.gnome.gnome-commander.gschema.xml:744
msgid "Normal foreground color in custom mode."
msgstr "Barva normálního popředí ve vlastním režimu."

#: data/org.gnome.gnome-commander.gschema.xml:750
msgid "Normal background color"
msgstr "Barva normálního pozadí"

#: data/org.gnome.gnome-commander.gschema.xml:751
msgid "Normal background color in custom mode."
msgstr "Barva normálního pozadí ve vlastním režimu."

#: data/org.gnome.gnome-commander.gschema.xml:757
msgid "Alternate foreground color"
msgstr "Střídavá barva popředí"

#: data/org.gnome.gnome-commander.gschema.xml:758
msgid "Alternate foreground color in custom mode."
msgstr "Barva střídavého popředí ve vlastním režimu."

#: data/org.gnome.gnome-commander.gschema.xml:764
msgid "Alternate background color"
msgstr "Střídavá barva pozadí"

#: data/org.gnome.gnome-commander.gschema.xml:765
msgid "Alternate background color in custom mode."
msgstr "Barva střídavého pozadí ve vlastním režimu."

#: data/org.gnome.gnome-commander.gschema.xml:771
msgid "Selection foreground color"
msgstr "Barva popředí výběru"

#: data/org.gnome.gnome-commander.gschema.xml:772
msgid "Foreground color for selections in custom mode."
msgstr "Barva popředí pro výběr ve vlastním režimu."

#: data/org.gnome.gnome-commander.gschema.xml:778
msgid "Selection background color"
msgstr "Barva pozadí výběru"

#: data/org.gnome.gnome-commander.gschema.xml:779
msgid "Background color for selections in custom mode."
msgstr "Barva pozadí pro výběr ve vlastním režimu."

#: data/org.gnome.gnome-commander.gschema.xml:785
msgid "Cursor foreground color"
msgstr "Barva popředí kurzoru"

#: data/org.gnome.gnome-commander.gschema.xml:786
msgid "Cursor foreground color in custom mode."
msgstr "Barva popředí kurzoru ve vlastním režimu."

#: data/org.gnome.gnome-commander.gschema.xml:792
msgid "Cursor background color"
msgstr "Barva pozadí kurzoru"

#: data/org.gnome.gnome-commander.gschema.xml:793
msgid "Cursor background color in custom mode."
msgstr "Barva pozadí kurzoru ve vlastním režimu."

#: data/org.gnome.gnome-commander.gschema.xml:799
msgid "Use LS colors"
msgstr "Používat barvy LS"

#: data/org.gnome.gnome-commander.gschema.xml:800
msgid ""
"This option triggers if the value of the environment variable LS_COLORS "
"should be used to dye files and folders."
msgstr ""
"Tato volba aktivuje, jestli se má k obarvení souborů a složek použít hodnota "
"proměnné prostředí LS_COLORS."

#: data/org.gnome.gnome-commander.gschema.xml:807
msgid "LS_COLORS black foreground mapping"
msgstr "Mapování černého popředí LS_COLORS"

#: data/org.gnome.gnome-commander.gschema.xml:808
msgid ""
"This option adjusts the foreground color mapping for LS_COLORS black value."
msgstr ""
"Tato volba upravuje mapování barvy popředí pro hodnotu černé z LS_COLORS."

#: data/org.gnome.gnome-commander.gschema.xml:814
msgid "LS_COLORS black background mapping"
msgstr "Mapování černého pozadí LS_COLORS"

#: data/org.gnome.gnome-commander.gschema.xml:815
msgid ""
"This option adjusts the background color mapping for LS_COLORS black value."
msgstr ""
"Tato volba upravuje mapování barvy pozadí pro hodnotu černé z LS_COLORS."

#: data/org.gnome.gnome-commander.gschema.xml:821
msgid "LS_COLORS red foreground mapping"
msgstr "Mapování červeného popředí LS_COLORS"

#: data/org.gnome.gnome-commander.gschema.xml:822
msgid ""
"This option adjusts the foreground color mapping for LS_COLORS red value."
msgstr ""
"Tato volba upravuje mapování barvy popředí pro hodnotu červené z LS_COLORS."

#: data/org.gnome.gnome-commander.gschema.xml:828
msgid "LS_COLORS red background mapping"
msgstr "Mapování červeného pozadí LS_COLORS"

#: data/org.gnome.gnome-commander.gschema.xml:829
msgid ""
"This option adjusts the background color mapping for LS_COLORS red value."
msgstr ""
"Tato volba upravuje mapování barvy pozadí pro hodnotu červené z LS_COLORS."

#: data/org.gnome.gnome-commander.gschema.xml:835
msgid "LS_COLORS green foreground mapping"
msgstr "Mapování zeleného popředí LS_COLORS"

#: data/org.gnome.gnome-commander.gschema.xml:836
msgid ""
"This option adjusts the foreground color mapping for LS_COLORS green value."
msgstr ""
"Tato volba upravuje mapování barvy popředí pro hodnotu zelené z LS_COLORS."

#: data/org.gnome.gnome-commander.gschema.xml:842
msgid "LS_COLORS green background mapping"
msgstr "Mapování zeleného pozadí LS_COLORS"

#: data/org.gnome.gnome-commander.gschema.xml:843
msgid ""
"This option adjusts the background color mapping for LS_COLORS green value."
msgstr ""
"Tato volba upravuje mapování barvy pozadí pro hodnotu zelené z LS_COLORS."

#: data/org.gnome.gnome-commander.gschema.xml:849
msgid "LS_COLORS yellow foreground mapping"
msgstr "Mapování žlutého popředí LS_COLORS"

#: data/org.gnome.gnome-commander.gschema.xml:850
msgid ""
"This option adjusts the foreground color mapping for LS_COLORS yellow value."
msgstr ""
"Tato volba upravuje mapování barvy popředí pro hodnotu žluté z LS_COLORS."

#: data/org.gnome.gnome-commander.gschema.xml:856
msgid "LS_COLORS yellow background mapping"
msgstr "Mapování žlutého pozadí LS_COLORS"

#: data/org.gnome.gnome-commander.gschema.xml:857
msgid ""
"This option adjusts the background color mapping for LS_COLORS yellow value."
msgstr ""
"Tato volba upravuje mapování barvy pozadí pro hodnotu žluté z LS_COLORS."

#: data/org.gnome.gnome-commander.gschema.xml:863
msgid "LS_COLORS blue foreground mapping"
msgstr "Mapování modrého popředí LS_COLORS"

#: data/org.gnome.gnome-commander.gschema.xml:864
msgid ""
"This option adjusts the foreground color mapping for LS_COLORS blue value."
msgstr ""
"Tato volba upravuje mapování barvy popředí pro hodnotu modré z LS_COLORS."

#: data/org.gnome.gnome-commander.gschema.xml:870
msgid "LS_COLORS blue background mapping"
msgstr "Mapování modrého pozadí LS_COLORS"

#: data/org.gnome.gnome-commander.gschema.xml:871
msgid ""
"This option adjusts the background color mapping for LS_COLORS blue value."
msgstr ""
"Tato volba upravuje mapování barvy pozadí pro hodnotu modré z LS_COLORS."

#: data/org.gnome.gnome-commander.gschema.xml:877
msgid "LS_COLORS magenta foreground mapping"
msgstr "Mapování purpurového popředí LS_COLORS"

#: data/org.gnome.gnome-commander.gschema.xml:878
msgid ""
"This option adjusts the foreground color mapping for LS_COLORS magenta value."
msgstr ""
"Tato volba upravuje mapování barvy popředí pro hodnotu purpurové z LS_COLORS."

#: data/org.gnome.gnome-commander.gschema.xml:884
msgid "LS_COLORS magenta background mapping"
msgstr "Mapování purpurového pozadí LS_COLORS"

#: data/org.gnome.gnome-commander.gschema.xml:885
msgid ""
"This option adjusts the background color mapping for LS_COLORS magenta value."
msgstr ""
"Tato volba upravuje mapování barvy pozadí pro hodnotu purpurové z LS_COLORS."

#: data/org.gnome.gnome-commander.gschema.xml:891
msgid "LS_COLORS cyan foreground mapping"
msgstr "Mapování azurového popředí LS_COLORS"

#: data/org.gnome.gnome-commander.gschema.xml:892
msgid ""
"This option adjusts the foreground color mapping for LS_COLORS cyan value."
msgstr ""
"Tato volba upravuje mapování barvy popředí pro hodnotu azurové z LS_COLORS."

#: data/org.gnome.gnome-commander.gschema.xml:898
msgid "LS_COLORS cyan background mapping"
msgstr "Mapování azurového pozadí LS_COLORS"

#: data/org.gnome.gnome-commander.gschema.xml:899
msgid ""
"This option adjusts the background color mapping for LS_COLORS cyan value."
msgstr ""
"Tato volba upravuje mapování barvy pozadí pro hodnotu azurové z LS_COLORS."

#: data/org.gnome.gnome-commander.gschema.xml:905
msgid "LS_COLORS white foreground mapping"
msgstr "Mapování bílého popředí LS_COLORS"

#: data/org.gnome.gnome-commander.gschema.xml:906
msgid ""
"This option adjusts the foreground color mapping for LS_COLORS white value."
msgstr ""
"Tato volba upravuje mapování barvy popředí pro hodnotu bílé z LS_COLORS."

#: data/org.gnome.gnome-commander.gschema.xml:912
msgid "LS_COLORS white background mapping"
msgstr "Mapování bílého pozadí LS_COLORS"

#: data/org.gnome.gnome-commander.gschema.xml:913
msgid ""
"This option adjusts the background color mapping for LS_COLORS white value."
msgstr ""
"Tato volba upravuje mapování barvy pozadí pro hodnotu bílé z LS_COLORS."

#: data/org.gnome.gnome-commander.gschema.xml:921
msgid "Case sensitive search"
msgstr "Rozlišovat velikost písmen při hledání"

#: data/org.gnome.gnome-commander.gschema.xml:922
msgid ""
"This option defines if searching within the internal viewer is case "
"sensitive."
msgstr ""
"Volba určující, jestli se má při hledání v interním prohlížeči rozlišovat "
"velikost písmen."

#: data/org.gnome.gnome-commander.gschema.xml:928
msgid "Search mode"
msgstr "Režim hledání"

#: data/org.gnome.gnome-commander.gschema.xml:929
msgid "This option defines the search mode of the internal viewer."
msgstr "Volba určující režim hledání v interním prohlížeči."

#: data/org.gnome.gnome-commander.gschema.xml:935
msgid "Character set"
msgstr "Znaková sada"

#: data/org.gnome.gnome-commander.gschema.xml:936
msgid "This option defines the default character encoding."
msgstr "Volba určující výchozí kódování znaků."

#: data/org.gnome.gnome-commander.gschema.xml:942
msgid "Monospaced font"
msgstr "Písmo s pevnou šířkou"

#: data/org.gnome.gnome-commander.gschema.xml:943
msgid ""
"Description of the monospaced font used to display text. It should include "
"at least font name and size but can also contain additional options like "
"Italic Light."
msgstr ""
"Popis písma s pevnou šířkou používaného k zobrazení textu. Mělo by obsahovat "
"alespoň název a velikost písma, ale může obsahovat i další možnosti, jako je "
"Italic Light."

#: data/org.gnome.gnome-commander.gschema.xml:950
msgid "Display hex offset"
msgstr "Zobrazovat pozici šestnáctkově"

#: data/org.gnome.gnome-commander.gschema.xml:951
msgid ""
"This option defines if the hexadecimal offset should be displayed in hex "
"mode."
msgstr ""
"Tato volba určuje, jestli se má pozice v souboru pro šestnáctkový režim "
"zobrazovat také šestnáctkově."

#: data/org.gnome.gnome-commander.gschema.xml:957
msgid "Wrap mode"
msgstr "Režim zalamování"

#: data/org.gnome.gnome-commander.gschema.xml:958
msgid "This option defines if too long text lines should be wrapped."
msgstr "Tato volba určuje, jestli se mají dlouhé řádky textu zalamovat."

#: data/org.gnome.gnome-commander.gschema.xml:964
msgid "Tab size"
msgstr "Velkost tabulátoru"

#: data/org.gnome.gnome-commander.gschema.xml:965
msgid ""
"This option defines the indentation width in terms of characters for a "
"tabulator character."
msgstr "Tato volba určuje odsazení, uvedené v počtu znaků, pro znak tabulátor."

#: data/org.gnome.gnome-commander.gschema.xml:971
msgid "Bytes per line in binary mode"
msgstr "Počet bajtů na řádek v binárním režimu"

#: data/org.gnome.gnome-commander.gschema.xml:972
msgid ""
"This option defines how many bytes should be displayed in one line in binary "
"mode."
msgstr ""
"Tato volba určuje, kolik bajtů se má zobrazovat na jednom řádku v binárním "
"režimu."

#: data/org.gnome.gnome-commander.gschema.xml:978
msgid "Metadata view"
msgstr "Zobrazení metadata"

#: data/org.gnome.gnome-commander.gschema.xml:979
msgid "This option defines if metadata should be visible."
msgstr "Tato volba určuje, jestli mají být viditelná metadata."

#: data/org.gnome.gnome-commander.gschema.xml:985
msgid "Window width"
msgstr "Šířka okna"

#: data/org.gnome.gnome-commander.gschema.xml:986
msgid "The width of the internal file viewer window."
msgstr "Šířka okna s interním prohlížečem souborů."

#: data/org.gnome.gnome-commander.gschema.xml:992
msgid "Window height"
msgstr "Výška okna"

#: data/org.gnome.gnome-commander.gschema.xml:993
msgid "The height of the internal file viewer window."
msgstr "Výška okna s interním prohlížečem souborů."

#: data/org.gnome.gnome-commander.gschema.xml:999
msgid "Window state"
msgstr "Stav okna"

#: data/org.gnome.gnome-commander.gschema.xml:1000
msgid ""
"The number represents the internal file viewer window state, e.g. "
"“maximized”, “fullscreen”, etc. and is calculated internally."
msgstr ""
"Číslo představuje vnitřní stav okna prohlížeče souborů, např. „maximální“, "
"„celá obrazovka“ atd. a vypočítává se interně."

#: data/org.gnome.gnome-commander.gschema.xml:1006
msgid "Search pattern for text"
msgstr "Vyhledávací vzor pro text"

#: data/org.gnome.gnome-commander.gschema.xml:1007
msgid ""
"This string array stores the history of text searches within the internal "
"file viewer."
msgstr ""
"Jedná se o pole řetězců uchovávajících historii hledání textu v interním "
"prohlížeči souborů."

#: data/org.gnome.gnome-commander.gschema.xml:1013
msgid "Search pattern for hex values"
msgstr "Vyhledávací vzor pro šestnáctkové hodnoty"

#: data/org.gnome.gnome-commander.gschema.xml:1014
msgid ""
"This string array stores the history of searches for hex values within the "
"internal file viewer."
msgstr ""
"Jedná se o pole řetězců uchovávajících historii hledání šestnáctkových "
"hodnot v interním prohlížeči souborů."

#: data/org.gnome.gnome-commander.gschema.xml:1022
msgid "Plugin metadata"
msgstr "Metadata zásuvného modulu"

#: data/org.gnome.gnome-commander.gschema.xml:1023
msgid "Metadata of known plugins by their file name."
msgstr "Metadata známých zásuvných modulů podle názvu souboru."

#: data/org.gnome.gnome-commander.gschema.xml:1029
msgid "Persistent settings"
msgstr "Trvalá nastavení"

#: data/org.gnome.gnome-commander.gschema.xml:1030
msgid "Settings persisted by the plugins."
msgstr "Nastavení byla zachována pomocí zásuvných modulů."

#: data/org.gnome.gnome-commander.metainfo.xml.in:17
msgid "Dual-panel file manager"
msgstr "Dvoupanelový správce souborů"

#: data/org.gnome.gnome-commander.metainfo.xml.in:19
msgid ""
"Gnome Commander is a “dual-panel” graphical file manager. It features "
"separate tabs for each panel, setting up custom device buttons, bookmark "
"manager, fully integrated commandline, file quick search, an internal image "
"viewer, a powerful batch renaming tool, and FTP and Samba access."
msgstr ""
"Gnome Commander je dvoupanelový grafický správce souborů. Jeho schopnosti "
"zahrnují karty pro každý panel zvlášť, nastavení vlastních tlačítek se "
"zařízeními, správu záložek, plně integrovaný příkazový řádek, rychlé "
"vyhledávání souborů, interní prohlížeč obrázků, mocný nástroj pro hromadné "
"přejmenování a přístup k FTP a Sambě."

#: data/org.gnome.gnome-commander.metainfo.xml.in:26
msgid ""
"Gnome Commander aims to advanced users who like to focus on precise file "
"management, working in parallel through special applications, and running "
"smart commands."
msgstr ""
"Gnome Commander cílí na pokročilé uživatele, kteří mají rádi pravě takovéto "
"správce souborů, pracují souběžně ve specializovaných aplikacích a spouští "
"promyšlené příkazy."

#: data/org.gnome.gnome-commander.metainfo.xml.in:36
msgid "file manager"
msgstr "správce souborů"

#: data/org.gnome.gnome-commander.metainfo.xml.in:37
msgid "file system"
msgstr "souborový systém"

