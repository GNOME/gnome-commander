msgstr ""
"Dette valget bestemmer om søk i den interne visningen skiller mellom store "
"og små bokstaver."

#: data/org.gnome.gnome-commander.gschema.xml:928
msgid "Search mode"
msgstr "Søkemodus"

#: data/org.gnome.gnome-commander.gschema.xml:929
msgid "This option defines the search mode of the internal viewer."
msgstr "Dette valget definerer søkemetoden til den interne viseren."

#: data/org.gnome.gnome-commander.gschema.xml:935
msgid "Character set"
msgstr "Tegnsett"

#: data/org.gnome.gnome-commander.gschema.xml:936
msgid "This option defines the default character encoding."
msgstr "Dette valget definerer standard tegnkodingen."

#: data/org.gnome.gnome-commander.gschema.xml:942
msgid "Monospaced font"
msgstr "Skrifttype med fast bredde"

#: data/org.gnome.gnome-commander.gschema.xml:943
msgid ""
"Description of the monospaced font used to display text. It should include "
"at least font name and size but can also contain additional options like "
"Italic Light."
msgstr ""

#: data/org.gnome.gnome-commander.gschema.xml:950
